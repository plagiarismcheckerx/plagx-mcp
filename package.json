{
  "name": "plagx-mcp",
  "version": "1.0.0",
  "mcpName": "io.github.plagiarismcheckerx/plagx-mcp",
  "description": "Plagx Cite + Preflight MCP: APA/MLA citations, reference list checks, BibTeX, DOI lookup and a draft checker (word count, citations vs. references, punctuation, basic grammar) for AI assistants. A free academic writing utility by Plagiarism Checker X.",
  "type": "module",
  "main": "./src/server.js",
  "bin": {
    "plagx-mcp": "./bin/plagx-mcp.js"
  },
  "exports": {
    ".": "./src/server.js",
    "./http": "./src/http.js"
  },
  "files": [
    "src",
    "bin"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node bin/plagx-mcp.js",
    "start:http": "node bin/plagx-mcp.js --http",
    "test": "node --test",
    "inspect": "npx @modelcontextprotocol/inspector node bin/plagx-mcp.js",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "citation",
    "apa",
    "mla",
    "bibliography",
    "reference-list",
    "bibtex",
    "doi",
    "essay-checker",
    "grammar-checker",
    "word-count",
    "academic-writing"
  ],
  "author": "Plagiarism Checker X (https://plagiarismcheckerx.com/)",
  "license": "MIT",
  "homepage": "https://github.com/plagiarismcheckerx/plagx-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plagiarismcheckerx/plagx-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/plagiarismcheckerx/plagx-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "plagx-cite": "0.2.2",
    "plagx-preflight": "0.1.3",
    "zod": "4.6.7"
  }
}
